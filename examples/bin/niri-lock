#!/bin/sh
# Blochează sesiunea. Folosit de Super+Alt+L, capacul laptopului și swayidle.
# Dacă "security.useShellLock" e activ, folosește ecranul NIRI MONOCHROME (WlSessionLock + PAM)
# și așteaptă confirmarea compozitorului. Dacă shell-ul nu răspunde, cade pe swaylock,
# deci sesiunea nu rămâne niciodată deblocată.
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/niri-monochrome/config.json"
ipc() { timeout 2 qs -c niri-monochrome ipc call lock "$@" 2>/dev/null; }

use_shell=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("security",{}).get("useShellLock",False))' "$cfg" 2>/dev/null)
if [ "$use_shell" = "True" ]; then
  [ "$(ipc isSecure)" = "true" ] && exit 0
  if ipc lockShell >/dev/null; then
    i=0
    while [ $i -lt 30 ]; do
      [ "$(ipc isSecure)" = "true" ] && exit 0
      sleep 0.1; i=$((i + 1))
    done
  fi
fi
pgrep -x swaylock >/dev/null && exit 0
exec swaylock -f
