// ---------- Monitoare (`niri msg outputs` listează modurile) ----------
output "eDP-1" {
    mode "1920x1080@144.001"
    scale 1
    position x=0 y=0
    // VRR doar când o fereastră cu regula `variable-refresh-rate` e vizibilă (jocuri, fullscreen).
    variable-refresh-rate on-demand=true
}

// Monitoare externe: niri le pune automat la dreapta cu scale 1 dacă nu sunt declarate.
// Exemplu: output "HDMI-A-1" { position x=1920 y=0; }
