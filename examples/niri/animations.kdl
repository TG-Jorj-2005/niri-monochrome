// ---------- Animații: spring-uri fără oscilație, puțin mai lente ----------
animations {
    slowdown 1.15

    workspace-switch         { spring damping-ratio=1.0 stiffness=600 epsilon=0.0001; }
    horizontal-view-movement { spring damping-ratio=1.0 stiffness=600 epsilon=0.0001; }
    window-movement          { spring damping-ratio=1.0 stiffness=550 epsilon=0.0001; }
    window-resize            { spring damping-ratio=1.0 stiffness=650 epsilon=0.0001; }
    overview-open-close      { spring damping-ratio=1.0 stiffness=600 epsilon=0.0001; }
    config-notification-open-close { spring damping-ratio=0.8 stiffness=800 epsilon=0.001; }

    window-open        { duration-ms 220; curve "ease-out-expo"; }
    window-close       { duration-ms 160; curve "ease-out-quad"; }
    screenshot-ui-open { duration-ms 200; curve "ease-out-quad"; }
}
