#!/usr/bin/env bash
# Volum ±5% / mute, cu OSD în mako (bara de progres).
case "$1" in
  up)   wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
  down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
  mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  mic)  wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
        if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then t="Microfon oprit"; else t="Microfon pornit"; fi
        notify-send -a osd -h string:x-canonical-private-synchronous:osd "$t"; exit 0 ;;
esac
raw=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
vol=$(awk '{printf "%d", $2*100}' <<<"$raw")
if grep -q MUTED <<<"$raw"; then
  notify-send -a osd -h string:x-canonical-private-synchronous:osd -h int:value:0 "Volum: mut"
else
  notify-send -a osd -h string:x-canonical-private-synchronous:osd -h int:value:"$vol" "Volum: ${vol}%"
fi
