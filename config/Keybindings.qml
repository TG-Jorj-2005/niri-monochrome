pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import qs.config

// Shell shortcuts live in niri (the compositor owns global keys). This singleton
// describes them and writes ~/.config/niri/niri-monochrome.kdl, which the user's
// config.kdl includes. niri reloads it automatically.
Singleton {
    id: kb

    readonly property string includePath: Constants.niriConfigDir + "/niri-monochrome.kdl"
    readonly property string qsCommand: "qs"

    // id, label, ipc target, ipc function
    readonly property var actions: [
        { id: "launcher",      label: "Application launcher",  target: "launcher",      fn: "toggle" },
        { id: "dock",          label: "Toggle dock",           target: "dock",          fn: "toggle" },
        { id: "notifications", label: "Notification center",   target: "notifications", fn: "toggle" },
        { id: "doNotDisturb",  label: "Do Not Disturb",        target: "notifications", fn: "toggleDnd" },
        { id: "controlCenter", label: "Control Center",        target: "controlcenter", fn: "toggle" },
        { id: "powerMenu",     label: "Power menu",            target: "power",         fn: "toggle" },
        { id: "settings",      label: "Settings",              target: "settings",      fn: "toggle" },
        { id: "lock",          label: "Lock screen (shell)",   target: "lock",          fn: "lock" },
        { id: "overview",      label: "Niri overview",         target: "niri",          fn: "toggleOverview" },
        { id: "wallpaperNext", label: "Next wallpaper",        target: "wallpaper",     fn: "next" }
    ]

    // Keys preserved from the user's own niri config (informational, shown in Settings/README).
    readonly property var preserved: [
        { key: "Mod+O",        label: "Overview (niri native)" },
        { key: "Mod+Space",    label: "Switch keyboard layout (us ⇄ ro)" },
        { key: "Super+Alt+L",  label: "Lock (swaylock, until the shell lock is enabled)" },
        { key: "Mod+1…9",      label: "Focus workspace N" },
        { key: "Mod+T / E / B",label: "Terminal / files / browser" },
        { key: "Ctrl+Shift+E", label: "Clipboard history" }
    ]

    readonly property var keyRegex: /^((Mod|Super|Ctrl|Alt|Shift|ISO_Level3_Shift|ISO_Level5_Shift)\+)*[A-Za-z0-9_]+$/

    function valid(key) { return key === "" || keyRegex.test(key) }

    function binding(id) { return UserConfig.data.shortcuts[id] || "" }

    function kdlText() {
        let out = "// Generated by NIRI MONOCHROME (" + Constants.version + "). Edit shortcuts in Settings → Shortcuts.\n"
        out += "// Regenerated on change; manual edits here will be overwritten.\n"
        out += "binds {\n"
        for (const a of actions) {
            const key = binding(a.id)
            if (!key || !valid(key)) continue
            out += "    " + key + " hotkey-overlay-title=\"" + a.label + "\" { spawn \"" + qsCommand + "\" \"-c\" \"" + Constants.configName + "\" \"ipc\" \"call\" \"" + a.target + "\" \"" + a.fn + "\"; }\n"
        }
        out += "}\n"
        return out
    }

    property string lastWritten: ""
    function write() {
        if (!UserConfig.data.shortcuts.writeNiriInclude) return
        const text = kdlText()
        if (text === lastWritten) return
        if (lastWritten === "") { try { if (writer.text() === text) { lastWritten = text; return } } catch (e) {} }
        lastWritten = text
        writer.setText(text)
    }
    FileView { id: writer; path: kb.includePath; atomicWrites: true; printErrors: false; blockLoading: true
        onSaveFailed: err => console.warn("[Keybindings] could not write", kb.includePath, FileViewError.toString(err)) }

    Connections { target: UserConfig; function onChanged() { if (UserConfig.loaded) kb.write() } }
    Connections { target: UserConfig; function onLoadedChanged() { if (UserConfig.loaded) kb.write() } }
}
