// Generated by NIRI MONOCHROME (2.0.0). Edit shortcuts in Settings → Shortcuts.
// Regenerated on change; manual edits here will be overwritten.
binds {
    Mod+D hotkey-overlay-title="Application launcher" { spawn "qs" "-c" "niri-monochrome" "ipc" "call" "launcher" "toggle"; }
    Mod+A hotkey-overlay-title="Toggle dock" { spawn "qs" "-c" "niri-monochrome" "ipc" "call" "dock" "toggle"; }
    Mod+Shift+A hotkey-overlay-title="Control Center" { spawn "qs" "-c" "niri-monochrome" "ipc" "call" "controlcenter" "toggle"; }
    Mod+X hotkey-overlay-title="Power menu" { spawn "qs" "-c" "niri-monochrome" "ipc" "call" "power" "toggle"; }
    Mod+Comma hotkey-overlay-title="Settings" { spawn "qs" "-c" "niri-monochrome" "ipc" "call" "settings" "toggle"; }
    Mod+Shift+W hotkey-overlay-title="Next wallpaper" { spawn "qs" "-c" "niri-monochrome" "ipc" "call" "wallpaper" "next"; }
}
